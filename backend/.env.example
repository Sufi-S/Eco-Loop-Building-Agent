# backend/.env.example — safe to commit; copy to .env and fill in real values.
# The real .env is gitignored; never commit your actual credentials.

# AWS Bedrock bearer token (required for real LLM mode; leave blank to use mock mode).
# This is the ONLY env var the agent actually reads.
AWS_BEARER_TOKEN_BEDROCK=

# Optional: AWS_DEFAULT_REGION is used by boto3's default credential chain.
# Note: agent.py currently hardcodes region_name="us-east-1" and the model ID
# "us.anthropic.claude-sonnet-4-6", so this line is informational only.
AWS_DEFAULT_REGION=us-east-1
